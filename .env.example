HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Omit to serve the versioned local snapshot. Set to use PostgreSQL instead.
# DATABASE_URL=postgresql://paleoatlas:paleoatlas@localhost:5432/paleoatlas
# Use a provider-issued connection URL with its required SSL parameters in production.
CATALOG_PATH=data/catalog.json
# Explicit comma-separated origins, or * for a public read-only catalog.
CORS_ORIGIN=*
